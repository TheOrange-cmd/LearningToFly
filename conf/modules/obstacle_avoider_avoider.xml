<!DOCTYPE module SYSTEM "module.dtd">

<module name="obstacle_avoider_avoider" dir="computer_vision/obstacle_avoidance">
  <doc>
    <description>
      Obstacle avoidance module using neural network-based detection of obstacles and floor
    </description>
  </doc>
  <settings>
    <dl_settings>
        <dl_settings name="obstacle_avoider">
            <!-- Toggle use of border detection -->
            <dl_setting var="use_border_detection" min="0" max="1" step="1" 
                shortname="use_border_detection" module="obstacle_avoider_avoider"
                values="OFF|ON"/>
            <!-- Speed and heading settings -->
            <dl_setting var="oag_max_speed" min="0" step="0.1" max="2.0" shortname="max_speed" module="obstacle_avoider_avoider" param="OAG_MAX_SPEED"/>
            <dl_setting var="oag_min_speed" min="0.0" step="0.1" max="1.0" shortname="min_speed" module="obstacle_avoider_avoider"/>
            <dl_setting var="oag_max_strafe_ratio" min="0.0" step="0.1" max="1.0" shortname="max_strafe" module="obstacle_avoider_avoider"/>
            <dl_setting var="oag_max_heading_rate" min="0" step="0.1" max="3" shortname="max_head_rate" module="obstacle_avoider_avoider"/>
            <!-- Thresholds -->
            <dl_setting var="danger_threshold" min="0.0" step="0.1" max="1.0" shortname="danger_thresh" module="obstacle_avoider_avoider"/>
            <dl_setting var="speed_danger_threshold" min="0.0" step="0.1" max="1.0" shortname="speed_danger_thresh" module="obstacle_avoider_avoider"/>
            <dl_setting var="stop_danger_threshold" min="0.0" step="0.1" max="1.2" shortname="stop_danger_thresh" module="obstacle_avoider_avoider"/>
            <dl_setting var="border_threshold" min="0.0" step="0.05" max="1.0"/>
            <!-- Filter settings -->
            <dl_setting var="use_heading_filter" min="0" max="1" step="1" 
                shortname="use_heading_filter" module="obstacle_avoider_avoider"
                values="OFF|ON"/>
        </dl_settings>
    </dl_settings>
  </settings>
  
  <header>
    <file name="include/obstacle_avoider_avoider.h"/>
  </header>
  <init fun="obstacle_avoider_init()"/>
  <periodic fun="obstacle_avoider_periodic()" freq="10"/>
  <makefile target="ap|nps">
    <file name="src/avoider.c"/>
    <!-- Include paths -->
    <flag name="CFLAGS" value="I$(PAPARAZZI_HOME)/sw/airborne/modules/computer_vision/obstacle_avoidance/include"/>
  </makefile>
</module>