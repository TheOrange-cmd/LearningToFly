<!DOCTYPE module SYSTEM "module.dtd">
<module name="obstacle_avoider_obstacle_detection" dir="computer_vision/obstacle_detection">
  <doc>
    <description>
      Obstacle detection module for the TU Delft Autonomous MAV course. The module uses two small CNNs to 
      detect obstacles in the front camera image and the boundary of the Cyberzoo testing environment in the bottom camera image. 
      The bottom camera CNN is trained using a small amount of manually labeled data and some augmented 
      data using brightness, contrast, and small rotations.
      The front camera CNN is trained using a large amount of image-depth frame pairs generated 
      using MiDaS (https://arxiv.org/abs/1907.01341), an open-source monocular depth estimation model. 
      The data from MiDaS is converted to a simple danger value for three columns in the cropped 
      center square of the image to allow inference with a small CNN.
      Each column can have a value of 0-1, where 0 is safe and 1 is dangerous. The CNN is trained to predict the danger value for each column.
      The CNNs are trained using the PyTorch framework and converted to ONNX format, and then to pure C using ONNX2C to allow 
      inference without the use of external libraries like TFLite, to avoid cross-compilation issues.
    </description>
  </doc>

  <settings>
    <dl_settings>
      <dl_settings name="detection">
        <dl_setting var="obstacle_detection.front_enabled" min="0" max="1" step="1" 
              shortname="front_enable" module="obstacle_detection"
              values="OFF|ON"/>
        <dl_setting var="obstacle_detection.bottom_enabled" min="0" max="1" step="1" 
              shortname="bottom_enable" module="obstacle_detection"
              values="OFF|ON"/>
        <dl_setting var="detection_debug" min="0" max="1" step="1" 
                    shortname="debug" module="obstacle_detection"
                    values="OFF|ON"/>
        <dl_setting var="detection_debug_model" min="0" max="1" step="1"
                    shortname="debug_model" module="obstacle_detection"
                    values="OFF|ON"/>
        <dl_setting var="save_images" min="0" max="1" step="1"
                    shortname="save_images" module="obstacle_detection"
                    values="OFF|ON"/>
      </dl_settings>
    </dl_settings>
  </settings>

  <header>
    <file name="include/obstacle_detection.h"/>
    <file name="include/image_convert.h"/>
    <file name="include/inference.h"/>
    <file name="include/border_model_wrapper.h"/>
    <file name="include/image_utils.h"/>
    <file name="include/queue.h"/>
  </header>

  <init fun="obstacle_detection_init()"/>
  <periodic fun="obstacle_detection_periodic()" freq="5"/>

  <makefile target="ap|nps">
    <!-- Setup Video Feed -->
    <define name="VIDEO_THREAD" value="1"/>
    <define name="OBSTACLE_DETECTION_FRONT_CAMERA" value="front_camera"/>
    <define name="OBSTACLE_DETECTION_BOTTOM_CAMERA" value="bottom_camera"/>
    <define name="FRONT_CAMERA_WIDTH" value="240"/>
    <define name="FRONT_CAMERA_HEIGHT" value="520"/>
    <define name="BOTTOM_CAMERA_WIDTH" value="240"/>
    <define name="BOTTOM_CAMERA_HEIGHT" value="240"/>
    
    <!-- Include module source files -->
    <file name="src/obstacle_detection.c"/>
    <file name="src/image_convert.c"/>
    <file name="src/inference.c"/>
    <file name="src/obstacle_model_wrapper.c"/>
    <file name="src/border_model_wrapper.c"/>
    <file name="src/image_utils.c"/>
    <file name="src/queue.c"/>

    <!-- Include paths -->
    <flag name="CFLAGS" value="I$(PAPARAZZI_HOME)/sw/airborne/modules/computer_vision/obstacle_detection/include"/>
    
    <!-- Add math library -->
    <flag name="LDFLAGS" value="lm"/>

    <!-- Computer vision dependencies -->
    <flag name="CFLAGS" value="I$(PAPARAZZI_HOME)/sw/airborne/modules/computer_vision"/>
    <flag name="CFLAGS" value="I$(PAPARAZZI_HOME)/sw/airborne/modules/computer_vision/lib"/>

    <!-- Add pthread library -->
    <flag name="LDFLAGS" value="pthread"/>
  </makefile>
  <makefile target="ap">
      <!-- Real hardware specific stuff -->
      <!-- <configure name="VISION_LED" value="5"/> -->
      <!-- <define name="CAMERA_CAPTURE_MODE" value="1"/> -->

      <!-- Add explicit dependencies -->
      <raw>
          $(TARGET).CFLAGS += -DUSE_VIDEO_THREAD
      </raw>
  </makefile>

  <makefile target="nps">
      <!-- Simulator specific configuration -->
  </makefile>
</module>